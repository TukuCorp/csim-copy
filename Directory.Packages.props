<Project>

  <!-- Central package versions. FluentAssertions is pinned to the last Apache-2.0
       release (7.2.0): 8.x moved to a proprietary licence that requires a paid
       licence for commercial use, and a commercial Vietnam offering is on the table. -->
  <PropertyGroup>
    <FluentAssertionsVersion>7.2.0</FluentAssertionsVersion>
    <MicrosoftNetTestSdkVersion>17.12.0</MicrosoftNetTestSdkVersion>
    <XunitVersion>2.9.2</XunitVersion>
    <XunitRunnerVisualStudioVersion>2.8.2</XunitRunnerVisualStudioVersion>
    <CoverletCollectorVersion>6.0.2</CoverletCollectorVersion>
    <EntityFrameworkCoreVersion>9.0.20</EntityFrameworkCoreVersion>
    <NpgsqlEfCoreVersion>9.0.4</NpgsqlEfCoreVersion>
    <AspNetCoreTestVersion>9.0.20</AspNetCoreTestVersion>
    <IdentityCoreVersion>9.0.20</IdentityCoreVersion>
    <!-- bUnit 1.x is the line that still runs on xUnit 2, which this solution uses; bUnit 2.x
         targets xUnit v3 only. -->
    <BunitVersion>1.40.0</BunitVersion>
    <PlaywrightVersion>1.63.0</PlaywrightVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="FluentAssertions" Version="$(FluentAssertionsVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNetTestSdkVersion)" />
    <PackageVersion Include="xunit" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)" />
    <PackageVersion Include="coverlet.collector" Version="$(CoverletCollectorVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="$(IdentityCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreTestVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(AspNetCoreTestVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="$(AspNetCoreTestVersion)" />
    <PackageVersion Include="bunit" Version="$(BunitVersion)" />
    <PackageVersion Include="Microsoft.Playwright" Version="$(PlaywrightVersion)" />
  </ItemGroup>

</Project>
