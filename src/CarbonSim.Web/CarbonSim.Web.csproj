<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Sorting and paging for the history tables, as the stack decision records. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
    <!-- PasswordHasher<PlayerAccount> comes from Microsoft.Extensions.Identity.Core, which is part
         of the ASP.NET Core shared framework from .NET 10, so it needs no package reference. -->
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped scenarios travel with the app, so a published folder needs nothing from the
         source tree (CarbonSimHostOptions.ScenarioPath looks here after the content root). -->
    <Content Include="..\..\scenarios\*.json" Link="scenarios\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarbonSim.Engine\CarbonSim.Engine.csproj" />
    <ProjectReference Include="..\CarbonSim.Data\CarbonSim.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests measure the shared view cache directly, which is internal to the host. -->
    <InternalsVisibleTo Include="CarbonSim.Web.Tests" />
  </ItemGroup>

</Project>
