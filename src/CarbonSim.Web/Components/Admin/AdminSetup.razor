@page "/admin/setup"
@layout AdminLayout
@using CarbonSim.Engine.Scenarios
@inject IStringLocalizer<SharedStrings> Strings
@inject IAdminSession Session
@inject AdminContext Context
@inject NavigationManager Navigation

<PageTitle>@Strings["AdminSetup"]</PageTitle>
<h1>@Strings["AdminSetup"]</h1>

@if (_errors.Count > 0)
{
    <div class="notice notice-error">
        @foreach (string error in _errors)
        {
            <p>@error</p>
        }
    </div>
}

@if (Draft is null)
{
    <p class="muted">@Strings["AdminAccessDenied"]</p>
}
else
{
    <div class="cards">
        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminRegistration"]</h2>
            <label class="check"><input id="admin-registration-open" type="checkbox" @bind="_registrationOpen" /> @Strings["AdminRegistrationOpen"]</label>
            <label>@Strings["AdminAccessPin"]<input id="admin-pin" type="text" @bind="_pin" /></label>
            <p class="muted small">@Strings["AdminCompaniesOnOffer"]: @Draft.Companies.Count</p>
            <button class="button" id="admin-save-registration" @onclick="SaveRegistrationAsync">@Strings["AdminSave"]</button>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminParameters"]</h2>
            <dl class="metrics">
                <div><dt>@Strings["AdminName"]</dt><dd><input type="text" aria-label="@Strings["AdminName"]" @bind="Draft.Name" /></dd></div>
                <div><dt>@Strings["AdminSeed"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["AdminSeed"]" @bind="Draft.Seed" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["Cap"]</dt><dd><input id="setup-cap" type="text" inputmode="decimal" aria-label="@Strings["Cap"]" @bind="Draft.Parameters.Cap" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["AnnualCapReductionRate"]</dt><dd><input type="text" inputmode="decimal" step="0.001" aria-label="@Strings["AnnualCapReductionRate"]" @bind="Draft.Parameters.AnnualCapReductionRate" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["FreeAllocationShare"]</dt><dd><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["FreeAllocationShare"]" @bind="Draft.Parameters.FreeAllocationShare" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["GovernmentReserveToAuctionPercent"]</dt><dd><input id="setup-reserve-to-auction" type="text" inputmode="decimal" step="0.01" aria-label="@Strings["GovernmentReserveToAuctionPercent"]" @bind="Draft.Parameters.GovernmentReserveToAuctionPercent" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["Year"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["Year"]" @bind="Draft.Parameters.Years" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["OffsetUsageLimit"]</dt><dd><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["OffsetUsageLimit"]" @bind="Draft.Parameters.OffsetUsageLimit" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["BankingLimit"]</dt><dd><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["BankingLimit"]" @bind="Draft.Parameters.BankingLimit" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["PenaltyPerTonne"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["PenaltyPerTonne"]" @bind="Draft.Parameters.PenaltyPerTonne" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["PenaltyAllowanceDebit"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["PenaltyAllowanceDebit"]" @bind="Draft.Parameters.PenaltyAllowanceDebit" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["AuctionFloorPrice"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["AuctionFloorPrice"]" @bind="Draft.Parameters.AuctionFloorPrice" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["AuctionCeilingPrice"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["AuctionCeilingPrice"]" @bind="Draft.Parameters.AuctionCeilingPrice" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["AuctionsPerYear"]</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["AuctionsPerYear"]" @bind="Draft.Parameters.AuctionsPerYear" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["YearLength"] (min)</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["YearLength"]" @bind="Draft.Parameters.YearLengthMinutes" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["AuctionDuration"] (min)</dt><dd><input type="text" inputmode="decimal" aria-label="@Strings["AuctionDuration"]" @bind="Draft.Parameters.AuctionDurationMinutes" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["VolatilityBand"]</dt><dd><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["VolatilityBand"]" @bind="Draft.Parameters.VolatilityBand" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
                <div><dt>@Strings["InterestRate"]</dt><dd><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["InterestRate"]" @bind="Draft.Parameters.OverdraftInterestRate" @bind:culture="CultureInfo.CurrentCulture" /></dd></div>
            </dl>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminSectorsAndAbatement"]</h2>
            @foreach (DraftSector sector in Draft.Sectors)
            {
                <fieldset class="card">
                    <label>@Strings["AdminSectorName"]<input type="text" @bind="sector.Name" /></label>
                    <label>@Strings["AdminEmissionShare"]<input type="text" inputmode="decimal" step="0.01" @bind="sector.EmissionShare" @bind:culture="CultureInfo.CurrentCulture" /></label>

                    <table class="grid">
                        <thead>
                            <tr>
                                <th>@Strings["AdminAbatementCode"]</th>
                                <th>@Strings["AdminAbatementName"]</th>
                                <th>@Strings["AdminReductionShare"]</th>
                                <th>@Strings["AdminUpfrontPerTonne"]</th>
                                <th>@Strings["AdminNetRevenuePerTonne"]</th>
                                <th>@Strings["AdminImplementationYears"]</th>
                                <th>@Strings["AdminLifetimeYears"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DraftAbatementOption option in sector.AbatementOptions)
                            {
                                <tr>
                                    <td><input type="text" aria-label="@Strings["AdminAbatementCode"]" @bind="option.Code" /></td>
                                    <td><input type="text" aria-label="@Strings["AdminAbatementName"]" @bind="option.Name" /></td>
                                    <td><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["AdminReductionShare"]" @bind="option.AnnualReductionShare" @bind:culture="CultureInfo.CurrentCulture" /></td>
                                    <td><input type="text" inputmode="decimal" aria-label="@Strings["AdminUpfrontPerTonne"]" @bind="option.UpfrontCostPerTonne" @bind:culture="CultureInfo.CurrentCulture" /></td>
                                    <td><input type="text" inputmode="decimal" aria-label="@Strings["AdminNetRevenuePerTonne"]" @bind="option.AnnualNetRevenuePerTonne" @bind:culture="CultureInfo.CurrentCulture" /></td>
                                    <td><input type="text" inputmode="decimal" aria-label="@Strings["AdminImplementationYears"]" @bind="option.ImplementationYears" @bind:culture="CultureInfo.CurrentCulture" /></td>
                                    <td><input type="text" inputmode="decimal" aria-label="@Strings["AdminLifetimeYears"]" @bind="option.LifetimeYears" @bind:culture="CultureInfo.CurrentCulture" /></td>
                                    <td><button class="button ghost small-button" @onclick="() => sector.AbatementOptions.Remove(option)">@Strings["AdminRemove"]</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <button class="button ghost small-button" @onclick="() => sector.AbatementOptions.Add(new DraftAbatementOption())">@Strings["AdminAddOption"]</button>
                </fieldset>
            }
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminGrowth"]</h2>
            <table class="grid">
                <thead>
                    <tr>
                        <th>@Strings["Sector"]</th>
                        <th>@Strings["AdminMinimumRate"]</th>
                        <th>@Strings["AdminMaximumRate"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DraftGrowth growth in Draft.Parameters.BausGrowthBySector)
                    {
                        <tr>
                            <td>@growth.Sector</td>
                            <td><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["AdminMinimumRate"]" @bind="growth.MinAnnualRate" @bind:culture="CultureInfo.CurrentCulture" /></td>
                            <td><input type="text" inputmode="decimal" step="0.01" aria-label="@Strings["AdminMaximumRate"]" @bind="growth.MaxAnnualRate" @bind:culture="CultureInfo.CurrentCulture" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="card wide" tabindex="0">
            <button class="button" id="admin-create-run" @onclick="CreateAsync">@Strings["AdminCreateRun"]</button>
        </section>
    </div>
}

@code {
    private ScenarioDraft? _draft;
    private List<string> _errors = [];
    private bool _registrationOpen;
    private string _pin = string.Empty;

    private ScenarioDraft? Draft => _draft;

    protected override async Task OnInitializedAsync()
    {
        await Context.AttachAsync(null);
        _registrationOpen = Context.Snapshot.Registration.Open;
        _pin = Context.Snapshot.Registration.Pin;
        _draft = await Session.SetupDraftAsync();
    }

    private Task SaveRegistrationAsync() =>
        Context.ActAsync(
            session => session.SetRegistrationAsync(_registrationOpen, _pin),
            Strings["AdminRegistrationSaved"]);

    private async Task CreateAsync()
    {
        if (_draft is null)
        {
            return;
        }

        _errors = [];

        try
        {
            Guid id = await Session.CreateRunAsync(_draft);
            await Context.RefreshAsync();
            Navigation.NavigateTo(AdminRoute.Run(id));
        }
        catch (ScenarioLoadException exception)
        {
            _errors = [.. exception.Errors];
        }
        catch (Exception exception)
        {
            _errors = [exception.Message];
        }
    }
}
