@page "/admin/run/{SimulationId:guid}/reports"
@layout AdminLayout
@inject IStringLocalizer<SharedStrings> Strings
@using CarbonSim.Engine.Reporting

@if (Run is not { } run)
{
    <p class="muted">@Strings["AdminSelectRunHint"]</p>
}
else
{
    <PageTitle>@Strings["AdminReports"]</PageTitle>
    <h1>@Strings["AdminReports"]</h1>

    <div class="cards">
        <section class="card wide" tabindex="0">
            <h2>@Strings["SystemReport"]</h2>
            <p><a class="button ghost small-button" href="@Csv(AdminReport.System)">@Strings["AdminExportCsv"]</a></p>
            <table class="grid">
                <thead>
                    <tr><th>@Strings["Product"]</th><th>@Strings["ThisYear"]</th><th>@Strings["ToDate"]</th></tr>
                </thead>
                <tbody>
                    @foreach (SystemReportRow row in SystemReportRows.For(Strings, run.ThisYear, run.ToDate))
                    {
                        <tr><td>@row.Label</td><td>@row.ThisYear</td><td>@row.ToDate</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminPriceReport"]</h2>
            <p><a class="button ghost small-button" href="@Csv(AdminReport.Prices)">@Strings["AdminExportCsv"]</a></p>
            <EChart Option="@PriceChart(run)" Height="240px" Label="@Strings["AdminPriceReport"]" /> 
            <table class="grid">
                <thead>
                    <tr>
                        <th>@Strings["Year"]</th>
                        <th>@Strings["AllowanceVolumeAllChannels"]</th>
                        <th>@Strings["AverageAllowancePriceAllChannels"]</th>
                        <th>@Strings["Offset"] @Strings["Volume"]</th>
                        <th>@Strings["Average"] @Strings["Offset"]</th>
                        <th>@Strings["Average"] @Strings["AuctionNumber"]</th>
                        <th>@Strings["ClearedAt"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdminPriceView price in run.Prices)
                    {
                        <tr>
                            <td>@price.Year</td>
                            <td>@Display.Tonnes(price.AllowanceVolume)</td>
                            <td>@Display.Price(price.AllowanceAverage)</td>
                            <td>@Display.Tonnes(price.OffsetVolume)</td>
                            <td>@Display.Price(price.OffsetAverage)</td>
                            <td>@Display.Price(price.AuctionAverage)</td>
                            <td>@Display.Price(price.AuctionLow) - @Display.Price(price.AuctionHigh)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminCompanyReport"]</h2>
            <p><a class="button ghost small-button" href="@Csv(AdminReport.Companies)">@Strings["AdminExportCsv"]</a></p>
            <table class="grid">
                <thead>
                    <tr>
                        <th>@Strings["Company"]</th>
                        <th>@Strings["Sector"]</th>
                        <th>@Strings["Capital"]</th>
                        <th>@Strings["ForecastEmissions"]</th>
                        <th>@Strings["FreeAllowancesThisYear"]</th>
                        <th>@Strings["Shortfall"]</th>
                        <th>@Strings["CostOfComplianceThisYear"]</th>
                        <th>@Strings["MarginalCostOfComplianceThisYear"]</th>
                        <th>@Strings["FinalLongShortPosition"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdminCompanyView company in run.Companies)
                    {
                        <tr>
                            <td>@company.Name</td>
                            <td>@company.Sector</td>
                            <td>@Display.Money(company.Capital)</td>
                            <td>@Display.Tonnes(company.Emissions)</td>
                            <td>@Display.Tonnes(company.FreeAllocation)</td>
                            <td>@Display.Tonnes(company.Shortfall)</td>
                            <td>@Display.Money(company.CostOfCompliance)</td>
                            <td>@Display.Signed(company.MarginalCost)</td>
                            <td>@Display.Tonnes(company.FinalPosition)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["EndOfYearCompanyReport"]</h2>
            <label>
                @Strings["Company"]
                <select id="admin-company-report-company" @bind="_reportCompany">
                    @foreach (AdminCompanyReportView company in run.CompanyReports)
                    {
                        <option value="@company.Company">@company.Company</option>
                    }
                </select>
            </label>
            <CompanyReportTable Reports="ReportFor(run)" />
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminUnitReport"]</h2>
            <p><a class="button ghost small-button" href="@Csv(AdminReport.Units)">@Strings["AdminExportCsv"]</a></p>
            <table class="grid">
                <thead>
                    <tr>
                        <th>@Strings["UnitName"]</th>
                        <th>@Strings["Company"]</th>
                        <th>@Strings["BaselineEmissions"]</th>
                        <th>@Strings["FreeAllowancesThisYear"]</th>
                        <th>@Strings["ForecastEmissions"]</th>
                        <th>@Strings["EmissionReductions"]</th>
                        <th>@Strings["Abatement"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdminUnitView unit in run.Units)
                    {
                        <tr>
                            <td>@unit.Name</td>
                            <td>@unit.Company</td>
                            <td>@Display.Tonnes(unit.BaselineEmissions)</td>
                            <td>@Display.Tonnes(unit.FreeAllocation)</td>
                            <td>@Display.Tonnes(unit.ForecastEmissions)</td>
                            <td>@Display.Tonnes(unit.Reduction)</td>
                            <td>@unit.ImplementedCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["Leaderboard"]</h2>
            <p><a class="button ghost small-button" href="@Csv(AdminReport.Leaderboard)">@Strings["AdminExportCsv"]</a></p>
            <label>
                @Strings["Leaderboard"]
                <select id="admin-leaderboard-period" @bind="_period">
                    <option value="0">@Strings["Overall"]</option>
                    @foreach (AdminLeaderYearView board in run.LeaderboardYears)
                    {
                        <option value="@board.Year">@Strings["LeaderboardYear_X", board.Year]</option>
                    }
                </select>
            </label>
            <label>
                @Strings["FilterBySector"]
                <select id="admin-leaderboard-sector" @bind="_sector">
                    <option value="">@Strings["AdminEveryone"]</option>
                    @foreach (string sector in run.Leaderboard.Select(row => row.Sector).Where(sector => sector.Length > 0).Distinct().Order(StringComparer.Ordinal))
                    {
                        <option value="@sector">@sector</option>
                    }
                </select>
            </label>
            <table class="grid" id="admin-leaderboard-table">
                <thead>
                    <tr>
                        <th>@Strings["Rank"]</th>
                        <th>@Strings["Company"]</th>
                        <th>@Strings["UnitNamePlayer"]</th>
                        <th>@Strings[_period == 0 ? "OverallMarginalCostOfCompliance" : "MarginalCostOfComplianceThisYear"]</th>
                        <th>@Strings["FinalLongShortPosition"]</th>
                        <th>@Strings["Penalties"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdminLeaderView row in LeaderRows(run))
                    {
                        <tr>
                            <td>@row.Rank</td>
                            <td>@row.Company @(row.Automated ? "(AI)" : string.Empty)</td>
                            <td>@Display.Unit(row.Unit, row.Player, automated: false)</td>
                            <td>@Display.Signed(row.MarginalCost)</td>
                            <td>@Display.Tonnes(row.FinalPosition)</td>
                            <td>@Display.Money(row.Penalties)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </div>
}

@code {
    [CascadingParameter] private AdminSnapshot? Snapshot { get; set; }

    [Parameter] public Guid SimulationId { get; set; }

    private AdminRunDetail? Run => Snapshot?.RunId == SimulationId ? Snapshot?.Run : null;

    private string Csv(string report) => $"/api/admin/runs/{SimulationId:D}/reports/{report}.csv";

    private string? _reportCompany;

    /// <summary>Each channel's yearly average; a year with nothing traded in a channel is a gap.</summary>
    private string PriceChart(AdminRunDetail run) => Charts.YearlyAveragePrices(
        [.. run.Prices.Select(price => Strings["Year_X", price.Year].Value)],
        [
            (Strings["AverageAllowancePriceAllChannels"].Value, [.. run.Prices.Select(price => price.AllowanceVolume > 0m ? price.AllowanceAverage : (decimal?)null)]),
            (Strings["Offset"].Value, [.. run.Prices.Select(price => price.OffsetVolume > 0m ? price.OffsetAverage : (decimal?)null)]),
            (Strings["AllowanceAuction"].Value, [.. run.Prices.Select(price => price.AuctionAverage)]),
        ]);

    /// <summary>The picked company's reports; the first company until the trainer picks one.</summary>
    private IReadOnlyList<CarbonSim.Engine.Finance.CompanyYearReport> ReportFor(AdminRunDetail run) =>
        (run.CompanyReports.FirstOrDefault(company => company.Company == _reportCompany) ?? run.CompanyReports.FirstOrDefault())?.Years ?? [];

    // 0 is the whole run; a year number is that year's board.
    private int _period;
    private string _sector = string.Empty;

    private IEnumerable<AdminLeaderView> LeaderRows(AdminRunDetail run) =>
        (run.LeaderboardYears.FirstOrDefault(board => board.Year == _period)?.Rows ?? run.Leaderboard)
            .Where(row => _sector.Length == 0 || string.Equals(row.Sector, _sector, StringComparison.Ordinal));
}
