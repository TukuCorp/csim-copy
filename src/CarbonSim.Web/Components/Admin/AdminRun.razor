@page "/admin/run/{SimulationId:guid}"
@layout AdminLayout
@using CarbonSim.Web.Simulations
@inject IStringLocalizer<SharedStrings> Strings
@inject AdminContext Context

@if (Run is not { } run)
{
    <p class="muted">@Strings["AdminSelectRunHint"]</p>
}
else
{
    <PageTitle>@run.Name</PageTitle>
    <h1>@run.Name</h1>

    <div class="cards">
        <section class="card wide" tabindex="0">
            <dl class="metrics">
                <div><dt>@Strings["State"]</dt><dd>@Display.State(Strings, run.State)</dd></div>
                <div><dt>@Strings["Year"]</dt><dd>@run.Year / @run.Years</dd></div>
                <div><dt>@Strings["AuctionNumber"]</dt><dd>@run.Auction / @run.AuctionsPerYear</dd></div>
                @if (run.CountdownsApply)
                {
                    <div><dt>@Strings["VirtualDate"]</dt><dd id="admin-virtual-date">@Display.VirtualDate(run.Parameters.YearLength - run.TimeLeftInYear, run.Parameters.YearLength)</dd></div>
                    <div><dt>@Strings["AdminTimeLeftInYear"]</dt><dd>@Display.Duration(run.TimeLeftInYear)</dd></div>
                    <div><dt>@Strings["AdminAuctionOpensIn"]</dt><dd>@Display.Duration(run.TimeToAuctionOpen)</dd></div>
                    <div><dt>@Strings["AdminAuctionClosesIn"]</dt><dd>@Display.Duration(run.TimeToAuctionClose)</dd></div>
                }
            </dl>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminRunControls"]</h2>
            <div class="segments">
                @if (run.State == "Pending")
                {
                    <button class="button" id="admin-begin-year" @onclick="() => BeginAsync(run)">@Strings["AdminBeginYear"]</button>
                }

                @if (run.ClockRunning)
                {
                    <button class="button ghost" id="admin-pause" @onclick="PauseAsync">@Strings["AdminPause"]</button>
                }
                else if (run.CanResume)
                {
                    <button class="button ghost" id="admin-resume" @onclick="ResumeAsync">@Strings["AdminResume"]</button>
                }

                @if (run.TimeToAutoResume is { } resumeIn)
                {
                    <span id="admin-auto-resume" class="muted small">@Strings["AutoResumeIn_X", (int)Math.Ceiling(resumeIn.TotalSeconds)]</span>
                    <button class="button ghost" id="admin-cancel-auto-resume" @onclick="CancelAutoResumeAsync">@Strings["CancelUnpause"]</button>
                }

                @if (run.State is "Running" or "Paused" or "PausedAfterAuction")
                {
                    <button class="button ghost" id="admin-halt" @onclick="() => HaltAsync()">@Strings["AdminHalt"]</button>
                }

                @if (run.State == "TradingHalted")
                {
                    <button class="button" id="admin-end-year" @onclick="EndYearAsync">@Strings["AdminEndYear"]</button>
                }

                @if (run.State == "YearEnded" && run.Year < run.Years)
                {
                    <button class="button" id="admin-begin-next-year" @onclick="() => BeginAsync(run)">@Strings["AdminBeginNextYear"]</button>
                }

                @if (run.CanEndSimulation)
                {
                    <button class="button ghost" id="admin-end-simulation" @onclick="EndSimulationAsync">@Strings["AdminEndSimulation"]</button>
                }
            </div>

            @if (run.YearIsOver)
            {
                <p class="notice notice-status" id="admin-year-over">@Strings["AdminYearOver"]</p>
            }

            <label>
                @Strings["AdminHaltWarn"]
                <input id="admin-halt-warn" type="text" inputmode="decimal" min="0" @bind="_warnSeconds" @bind:culture="CultureInfo.CurrentCulture" />
            </label>

            <p>
                @* The state is written out and the button says what pressing it does, so the two
                   cannot be read as contradicting each other. *@
                @Strings["AdminMessaging"]:
                <strong id="admin-messaging-state">@(run.MessagingEnabled ? Strings["AdminOn"] : Strings["AdminOff"])</strong>
                <button class="button small-button" id="admin-messaging-toggle" @onclick="() => ToggleMessagingAsync(run)">
                    @(run.MessagingEnabled ? Strings["AdminSwitchOff"] : Strings["AdminSwitchOn"])
                </button>
            </p>
            @if (_messagingNotice is { } messaging)
            {
                <p class="notice @(messaging.IsError ? "notice-error" : "notice-status")" role="status">@messaging.Text</p>
            }

            @* The phased exercise's switches, movable inside a year: closing a market cancels what is
               resting in it, so the button is the whole story. *@
            <p>
                @Strings["AdminExchangeAccess"]:
                <strong id="admin-exchange-state">@(run.ExchangeAccess ? Strings["AdminOn"] : Strings["AdminOff"])</strong>
                <button class="button small-button" id="admin-exchange-toggle" @onclick="() => SetAccessAsync(exchange: !run.ExchangeAccess)">
                    @(run.ExchangeAccess ? Strings["AdminSwitchOff"] : Strings["AdminSwitchOn"])
                </button>
            </p>
            <p>
                @Strings["AdminOtcAccess"]:
                <strong id="admin-otc-state">@(run.OtcAccess ? Strings["AdminOn"] : Strings["AdminOff"])</strong>
                <button class="button small-button" id="admin-otc-toggle" @onclick="() => SetAccessAsync(otc: !run.OtcAccess)">
                    @(run.OtcAccess ? Strings["AdminSwitchOff"] : Strings["AdminSwitchOn"])
                </button>
            </p>
            <p>
                @Strings["AdminLeaderboardVisible"]:
                <strong id="admin-leaderboard-state">@(run.LeaderboardVisible ? Strings["AdminOn"] : Strings["AdminOff"])</strong>
                <button class="button small-button" id="admin-leaderboard-toggle" @onclick="() => SetAccessAsync(leaderboard: !run.LeaderboardVisible)">
                    @(run.LeaderboardVisible ? Strings["AdminSwitchOff"] : Strings["AdminSwitchOn"])
                </button>
            </p>
        </section>

        <section class="card">
            <h2>@Strings["AdminAnnouncement"]</h2>
            <label for="announce-to">
                @Strings["AdminAnnounceTo"]
                <select id="announce-to" @bind="_announceTo">
                    <option value="">@Strings["AdminEveryone"]</option>
                    @foreach (AdminCompanyView company in run.Companies)
                    {
                        <option value="@company.Name">@company.Name</option>
                    }
                </select>
            </label>
            <label for="announce-text">@Strings["Message"]<textarea id="announce-text" rows="2" @bind="_announceText"></textarea></label>
            <button class="button" id="admin-announce" disabled="@string.IsNullOrWhiteSpace(_announceText)" @onclick="AnnounceAsync">@Strings["Send"]</button>
            @if (_announceNotice is { } announce)
            {
                <p class="notice @(announce.IsError ? "notice-error" : "notice-status")" role="status">@announce.Text</p>
            }
        </section>

        <section class="card">
            <h2>@Strings["AdminIssueFine"]</h2>
            <label for="fine-unit">
                @Strings["UnitName"]
                <select id="fine-unit" @bind="_fineUnitId">
                    @foreach (AdminUnitView unit in run.Units)
                    {
                        <option value="@unit.Id">@unit.Label</option>
                    }
                </select>
            </label>
            <label for="fine-amount">@Strings["AdminFineAmount"]<input id="fine-amount" type="text" inputmode="decimal" @bind="_fineAmount" @bind:culture="CultureInfo.CurrentCulture" /></label>
            <label for="fine-description">@Strings["AdminFineDescription"]<input id="fine-description" type="text" @bind="_fineDescription" /></label>
            <button class="button" @onclick="IssueFineAsync">@Strings["AdminIssueFine"]</button>
            @if (_fineNotice is { } fine)
            {
                <p class="notice @(fine.IsError ? "notice-error" : "notice-status")" role="status">@fine.Text</p>
            }
        </section>

        <section class="card">
            <h2>@Strings["AdminDisburseOffsets"]</h2>
            @* A unit, like the other three forms: offsets are handed to the company that owns it. *@
            <label for="offset-unit">
                @Strings["UnitName"]
                <select id="offset-unit" @bind="_offsetUnitId">
                    @foreach (AdminUnitView unit in run.Units)
                    {
                        <option value="@unit.Id">@unit.Label</option>
                    }
                </select>
            </label>
            <label for="offset-volume">@Strings["AdminOffsetVolume"]<input id="offset-volume" type="text" inputmode="decimal" @bind="_offsetVolume" @bind:culture="CultureInfo.CurrentCulture" /></label>
            <button class="button" @onclick="DisburseAsync">@Strings["AdminDisburseOffsets"]</button>
            @if (_offsetNotice is { } offsets)
            {
                <p class="notice @(offsets.IsError ? "notice-error" : "notice-status")" role="status">@offsets.Text</p>
            }
        </section>

        <section class="card">
            <h2>@Strings["AdminAddAbatement"]</h2>
            <label for="abatement-unit">
                @Strings["UnitName"]
                <select id="abatement-unit" @bind="_abatementUnitId">
                    @foreach (AdminUnitView unit in run.Units)
                    {
                        <option value="@unit.Id">@unit.Label</option>
                    }
                </select>
            </label>
            <label for="abatement-option">
                @Strings["AdminAbatementFor"]
                <select id="abatement-option" @bind="_abatementIndex">
                    @foreach (AdminAbatementOptionView option in OptionsFor(run))
                    {
                        <option value="@option.Index">@option.Code @option.Name (cost @Display.Money(option.UpfrontCost), -@Display.Tonnes(option.AnnualReduction) t/yr)</option>
                    }
                </select>
            </label>
            <button class="button" @onclick="AddAbatementAsync">@Strings["AdminAddAbatement"]</button>
            @if (_abatementNotice is { } abatement)
            {
                <p class="notice @(abatement.IsError ? "notice-error" : "notice-status")" role="status">@abatement.Text</p>
            }
        </section>

        <section class="card">
            <h2>@Strings["AdminShock"]</h2>
            <label for="shock-unit">
                @Strings["UnitName"]
                <select id="shock-unit" @bind="_shockUnitId">
                    @foreach (AdminUnitView unit in run.Units)
                    {
                        <option value="@unit.Id">@unit.Label</option>
                    }
                </select>
            </label>
            <label for="shock-year">@Strings["AdminShockYear"]<input id="shock-year" type="text" inputmode="decimal" min="1" max="@run.Years" @bind="_shockYear" @bind:culture="CultureInfo.CurrentCulture" /></label>
            <label for="shock-tonnes">@Strings["AdminShockTonnes"]<input id="shock-tonnes" type="text" inputmode="decimal" @bind="_shockTonnes" @bind:culture="CultureInfo.CurrentCulture" /></label>
            <button class="button" @onclick="ApplyShockAsync">@Strings["AdminApply"]</button>
            @if (_shockNotice is { } shock)
            {
                <p class="notice @(shock.IsError ? "notice-error" : "notice-status")" role="status">@shock.Text</p>
            }
        </section>

        <section class="card">
            <h2>@Strings["SystemModifications"]</h2>
            <p class="muted small">@Strings["SystemModificationsHint"]</p>
            <label for="compliance-offset-limit">
                @Strings["OffsetUsageLimit"] (%)
                <input id="compliance-offset-limit" type="text" inputmode="decimal" @bind="_offsetLimitPercent" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <label for="compliance-banking-limit">
                @Strings["BankingLimit"] (%)
                <input id="compliance-banking-limit" type="text" inputmode="decimal" @bind="_bankingLimitPercent" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <label for="compliance-penalty">
                @Strings["PenaltyPerTonne"] (@Display.Currency.Code)
                <input id="compliance-penalty" type="text" inputmode="decimal" @bind="_penalty" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <button class="button" id="admin-change-compliance" @onclick="ChangeComplianceAsync">@Strings["AdminApply"]</button>
            @if (_complianceNotice is { } compliance)
            {
                <p class="notice @(compliance.IsError ? "notice-error" : "notice-status")" role="status">@compliance.Text</p>
            }
        </section>

        <section class="card">
            <h2>@Strings["AdminChangeRules"]</h2>
            <p class="muted small">@Strings["AdminChangeRulesHint"]</p>
            <label for="rules-floor">
                @Strings["AuctionFloorPrice"]
                <input id="rules-floor" type="text" inputmode="decimal" @bind="_floor" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <label for="rules-ceiling">
                @Strings["AuctionCeilingPrice"]
                <input id="rules-ceiling" type="text" inputmode="decimal" @bind="_ceiling" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <button class="button" id="admin-change-rules" @onclick="ChangeRulesAsync">@Strings["AdminChangeRules"]</button>
            @if (run.RuleChanges.Count > 0)
            {
                <ul class="settings">
                    @foreach (RuleChange change in run.RuleChanges.AsEnumerable().Reverse().Take(5))
                    {
                        <li>
                            @Strings["Year_X", change.Year] &middot; @change.By &middot;
                            @Strings["AuctionFloorPrice"] @Display.Price(change.OldFloor) &rarr; @Display.Price(change.NewFloor) &middot;
                            @Strings["AuctionCeilingPrice"] @Display.Price(change.OldCeiling) &rarr; @Display.Price(change.NewCeiling)
                        </li>
                    }
                </ul>
            }
            @if (_rulesNotice is { } rules)
            {
                <p class="notice @(rules.IsError ? "notice-error" : "notice-status")" role="status">@rules.Text</p>
            }
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminAutomaticTrading"]</h2>
            <table class="grid">
                <thead>
                    <tr>
                        <th>@Strings["UnitName"]</th>
                        <th>@Strings["Company"]</th>
                        <th>@Strings["AdminAutomaticTrading"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AdminUnitView unit in run.Units)
                    {
                        <tr>
                            <td>@unit.Name</td>
                            <td>@unit.Company</td>
                            <td>@(unit.AutoTrade ? Strings["AdminOn"] : Strings["AdminOff"])</td>
                            <td>
                                <button class="button small-button" @onclick="() => ToggleAutoTradeAsync(unit)">
                                    @(unit.AutoTrade ? Strings["AdminOff"] : Strings["AdminOn"])
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["AdminParameters"]</h2>
            <dl class="metrics">
                <div><dt>@Strings["Cap"]</dt><dd>@Display.Tonnes(run.Parameters.Cap)</dd></div>
                <div><dt>@Strings["AnnualCapReductionRate"]</dt><dd>@Display.Percent2(run.Parameters.AnnualCapReductionRate)</dd></div>
                <div><dt>@Strings["FreeAllocationShare"]</dt><dd>@Display.Percent(run.Parameters.FreeAllocationShare)</dd></div>
                <div><dt>@Strings["OffsetUsageLimit"]</dt><dd>@Display.Percent(run.Parameters.OffsetUsageLimit)</dd></div>
                <div><dt>@Strings["BankingLimit"]</dt><dd>@Display.Percent(run.Parameters.BankingLimit)</dd></div>
                <div><dt>@Strings["PenaltyPerTonne"]</dt><dd>@Display.Money(run.Parameters.PenaltyPerTonne)</dd></div>
                <div><dt>@Strings["AuctionFloorPrice"]</dt><dd>@Display.Money(run.Parameters.AuctionFloorPrice)</dd></div>
                <div><dt>@Strings["AuctionCeilingPrice"]</dt><dd>@Display.Money(run.Parameters.AuctionCeilingPrice)</dd></div>
                <div><dt>@Strings["AuctionsPerYear"]</dt><dd>@run.Parameters.AuctionsPerYear</dd></div>
                <div><dt>@Strings["YearLength"]</dt><dd>@Display.Duration(run.Parameters.YearLength)</dd></div>
                <div><dt>@Strings["AuctionDuration"]</dt><dd>@Display.Duration(run.Parameters.AuctionDuration)</dd></div>
                <div><dt>@Strings["VolatilityBand"]</dt><dd>@Display.Percent(run.Parameters.VolatilityBand)</dd></div>
                <div><dt>@Strings["GovernmentReserveToAuctionPercent"]</dt><dd>@Display.Percent(run.Parameters.GovernmentReserveToAuctionPercent)</dd></div>
                <div><dt>@Strings["ForwardVintageShare"]</dt><dd>@Display.Percent(run.Parameters.ForwardVintageShare)</dd></div>
            </dl>
        </section>
    </div>
}

@code {
    [CascadingParameter] private AdminSnapshot? Snapshot { get; set; }

    [Parameter] public Guid SimulationId { get; set; }

    private AdminRunDetail? Run => Snapshot?.RunId == SimulationId ? Snapshot?.Run : null;

    private double? _warnSeconds;
    private ConsoleNotice? _messagingNotice;
    private ConsoleNotice? _announceNotice;
    private string _announceTo = string.Empty;
    private string _announceText = string.Empty;
    private ConsoleNotice? _fineNotice;
    private ConsoleNotice? _offsetNotice;
    private ConsoleNotice? _abatementNotice;
    private ConsoleNotice? _shockNotice;
    private ConsoleNotice? _rulesNotice;
    private decimal _floor;
    private decimal _ceiling;
    private ConsoleNotice? _complianceNotice;
    private decimal? _offsetLimitPercent;
    private decimal? _bankingLimitPercent;
    private decimal? _penalty;
    private int _fineUnitId;
    private decimal _fineAmount = 10_000m;
    private string _fineDescription = string.Empty;
    private int _offsetUnitId;
    private decimal _offsetVolume = 1_000m;
    private int _abatementUnitId;
    private int _abatementIndex;
    private int _shockUnitId;
    private int _shockYear = 1;
    private decimal _shockTonnes;

    private IReadOnlyList<AdminAbatementOptionView> OptionsFor(AdminRunDetail run) =>
        run.Units.FirstOrDefault(unit => unit.Id == _abatementUnitId)?.Opportunities ?? [];

    /// <summary>
    /// The forms open on the first unit and the first company, so a control that needs a choice
    /// has one and the trainer is not looking at a blank box wondering whether it worked.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Run is not { } run || run.Units.Count == 0 || run.Companies.Count == 0)
        {
            return;
        }

        _fineUnitId = Selected(_fineUnitId, run.Units.Select(unit => unit.Id));
        _abatementUnitId = Selected(_abatementUnitId, run.Units.Select(unit => unit.Id));
        _shockUnitId = Selected(_shockUnitId, run.Units.Select(unit => unit.Id));
        _offsetUnitId = Selected(_offsetUnitId, run.Units.Select(unit => unit.Id));

        if (_floor <= 0m)
        {
            _floor = run.Parameters.AuctionFloorPrice;
            _ceiling = run.Parameters.AuctionCeilingPrice;
        }

        // The modifications open on the rules in force, in per cent as the trainer reads them.
        _offsetLimitPercent ??= Percent(run.Parameters.OffsetUsageLimit);
        _bankingLimitPercent ??= Percent(run.Parameters.BankingLimit);
        _penalty ??= run.Parameters.PenaltyPerTonne;
    }

    // A share as the per cent a trainer types, without the trailing zeros the multiplication leaves (10, not 10.0).
    private static decimal Percent(decimal share) => share * 100m / 1.000000000000000000000000000m;

    private static int Selected(int chosen, IEnumerable<int> available) =>
        available.Contains(chosen) ? chosen : available.First();

    private static string UnitName(AdminRunDetail run, int unitId) =>
        run.Units.FirstOrDefault(unit => unit.Id == unitId)?.Label ?? string.Empty;

    private static string CompanyName(AdminRunDetail run, int companyId) =>
        run.Companies.FirstOrDefault(company => company.Id == companyId)?.Name ?? string.Empty;

    private static int CompanyOf(AdminRunDetail run, int unitId) =>
        run.Units.FirstOrDefault(unit => unit.Id == unitId)?.CompanyId ?? 0;

    private Task BeginAsync(AdminRunDetail run) =>
        Context.ActAsync(session => session.BeginYearAsync(SimulationId), Strings["AdminYearStarted"]);

    private Task PauseAsync() =>
        Context.ActAsync(session => session.PauseAsync(SimulationId), Strings["AdminPausedStatus"]);

    private Task ResumeAsync() =>
        Context.ActAsync(session => session.ResumeAsync(SimulationId), Strings["AdminResumedStatus"]);

    private Task EndYearAsync() =>
        Context.ActAsync(session => session.EndYearAsync(SimulationId), Strings["AdminYearEnded"]);

    private Task EndSimulationAsync() =>
        Context.ActAsync(session => session.EndSimulationAsync(SimulationId), Strings["AdminSimulationEnded"]);

    private Task ToggleMessagingAsync(AdminRunDetail run) =>
        ActAsync(
            session => session.SetMessagingAsync(SimulationId, !run.MessagingEnabled),
            Strings["AdminMessagingSaved"],
            notice => _messagingNotice = notice);

    private Task SetAccessAsync(bool? exchange = null, bool? otc = null, bool? leaderboard = null) =>
        ActAsync(
            session => session.SetMarketAccessAsync(SimulationId, exchange, otc, leaderboard),
            Strings["AdminAccessSaved"],
            notice => _messagingNotice = notice);

    private Task AnnounceAsync()
    {
        string text = _announceText.Trim();
        string? to = _announceTo.Length == 0 ? null : _announceTo;

        if (text.Length == 0)
        {
            return Task.CompletedTask;
        }

        _announceText = string.Empty;

        return ActAsync(
            session => session.AnnounceAsync(SimulationId, text, to),
            Strings["AdminAnnounced"],
            notice => _announceNotice = notice);
    }

    private Task ToggleAutoTradeAsync(AdminUnitView unit) =>
        Context.ActAsync(session => session.SetAutoTradeAsync(SimulationId, unit.Id, !unit.AutoTrade));

    private Task HaltAsync()
    {
        TimeSpan? warn = _warnSeconds is { } seconds and > 0 ? TimeSpan.FromSeconds(seconds) : null;

        return Context.ActAsync(
            session => session.HaltAsync(SimulationId, warn),
            warn is null ? Strings["AdminHaltedStatus"] : Strings["AdminHaltWarned"]);
    }

    private Task IssueFineAsync()
    {
        if (Run is not { } run || _fineUnitId <= 0)
        {
            _fineNotice = new ConsoleNotice(Strings["AdminChooseUnit"], IsError: true);
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(_fineDescription))
        {
            _fineNotice = new ConsoleNotice(Strings["AdminFineNeedsDescription"], IsError: true);
            return Task.CompletedTask;
        }

        return ActAsync(
            session => session.IssueFineAsync(SimulationId, _fineUnitId, _fineAmount, _fineDescription),
            Strings["AdminFinedUnit", UnitName(run, _fineUnitId), Display.Money(_fineAmount)],
            notice => _fineNotice = notice);
    }

    private Task DisburseAsync()
    {
        if (Run is not { } run || _offsetUnitId <= 0 || CompanyOf(run, _offsetUnitId) <= 0)
        {
            _offsetNotice = new ConsoleNotice(Strings["AdminChooseUnit"], IsError: true);
            return Task.CompletedTask;
        }

        if (_offsetVolume <= 0m)
        {
            _offsetNotice = new ConsoleNotice(Strings["AdminVolumeNeeded"], IsError: true);
            return Task.CompletedTask;
        }

        return ActAsync(
            session => session.DisburseOffsetsAsync(SimulationId, CompanyOf(run, _offsetUnitId), _offsetVolume),
            Strings["AdminOffsetsGivenTo", Display.Tonnes(_offsetVolume), CompanyName(run, CompanyOf(run, _offsetUnitId))],
            notice => _offsetNotice = notice);
    }

    private Task AddAbatementAsync()
    {
        if (Run is not { } run || _abatementUnitId <= 0 || OptionsFor(run).Count == 0)
        {
            _abatementNotice = new ConsoleNotice(Strings["AdminChooseUnit"], IsError: true);
            return Task.CompletedTask;
        }

        AdminAbatementOptionView option = OptionsFor(run).First(candidate => candidate.Index == _abatementIndex);

        return ActAsync(
            session => session.AddAbatementAsync(SimulationId, _abatementUnitId, _abatementIndex),
            Strings["AdminAbatementCommittedFor", $"{option.Code} {option.Name}", UnitName(run, _abatementUnitId)],
            notice => _abatementNotice = notice);
    }

    private Task ApplyShockAsync()
    {
        if (Run is not { } run || _shockUnitId <= 0)
        {
            _shockNotice = new ConsoleNotice(Strings["AdminChooseUnit"], IsError: true);
            return Task.CompletedTask;
        }

        return ActAsync(
            session => session.ApplyShockAsync(SimulationId, _shockUnitId, _shockYear, _shockTonnes),
            Strings["AdminShockAppliedToUnit", UnitName(run, _shockUnitId), _shockYear, Display.Tonnes(_shockTonnes)],
            notice => _shockNotice = notice);
    }

    /// <summary>The end-of-year modifications: offset usage limit, banking limit and cash penalty.</summary>
    private Task ChangeComplianceAsync() =>
        ActAsync(
            session => session.ChangeComplianceRulesAsync(SimulationId, _offsetLimitPercent / 100m, _bankingLimitPercent / 100m, _penalty),
            Strings["SystemModificationsApplied"],
            notice => _complianceNotice = notice);

    private Task CancelAutoResumeAsync() =>
        Context.ActAsync(session => session.CancelAutoResumeAsync(SimulationId), Strings["CancelUnpause"]);

    /// <summary>Moves the collar the year trades under; the market re-quotes at once.</summary>
    private Task ChangeRulesAsync() =>
        ActAsync(
            session => session.ChangeRulesAsync(SimulationId, _floor, _ceiling),
            Strings["AdminRulesChanged", Display.Price(_floor), Display.Price(_ceiling)],
            notice => _rulesNotice = notice);

    /// <summary>
    /// Runs a control and reports what happened where it happened: the console's own notice band
    /// sits at the top of the page, which is out of sight from a form halfway down it, and a
    /// refused action used to leave the trainer nothing to read at all.
    /// </summary>
    private async Task ActAsync(Func<IAdminSession, Task> action, string success, Action<ConsoleNotice?> report)
    {
        report(null);
        await Context.ActAsync(action, success);

        report(Context.Snapshot.Error is { } error
            ? new ConsoleNotice(error, IsError: true)
            : new ConsoleNotice(success, IsError: false));
    }

    /// <summary>What a console form has to say for itself.</summary>
    private sealed record ConsoleNotice(string Text, bool IsError);
}
