@page "/run/{SimulationId:guid}/company"
@inject IStringLocalizer<SharedStrings> Strings

<PageTitle>@Strings["CompanyManagement"]</PageTitle>
<h1>@Strings["CompanyManagement"]</h1>

@if (View is not { } view)
{
    <ScreenFallback Screen="Screen" />
}
else
{
    <div class="cards">
        <section class="card">
            <h2>@view.CompanyName</h2>
            <dl class="metrics">
                <div><dt>@Strings["Sector"]</dt><dd>@view.SectorName</dd></div>
                <div><dt>@Strings["Player"]</dt><dd>@view.PlayerName</dd></div>
                <div><dt>@Strings["Capital"]</dt><dd>@Display.Money(view.Finance.Capital)</dd></div>
                <div><dt>@Strings["EscrowedCash"]</dt><dd>@Display.Money(view.Finance.Escrowed)</dd></div>
                <div><dt>@Strings["Overdraft"]</dt><dd>@Display.Money(view.Finance.OverdraftLimit)</dd></div>
                <div><dt>@Strings["AvailableOverdraft"]</dt><dd>@Display.Money(view.Finance.AvailableOverdraft)</dd></div>
                <div><dt>@Strings["Units"]</dt><dd>@view.Units.Count</dd></div>
            </dl>
        </section>

        <section class="card">
            <h2>@Strings["Holdings"]</h2>
            @if (view.Holdings.Count == 0)
            {
                <p class="muted">@Strings["NoRows"]</p>
            }
            else
            {
                <QuickGrid Items="@view.Holdings.AsQueryable()" Class="grid">
                    <TemplateColumn Title="@Strings["Product"]" Context="row">@Display.Product(row.Product, Strings)</TemplateColumn>
                    <TemplateColumn Title="@Strings["Available"]" Context="row">@Display.Tonnes(row.Available)</TemplateColumn>
                    <TemplateColumn Title="@Strings["Committed"]" Context="row">@Display.Tonnes(row.Escrowed)</TemplateColumn>
                    <TemplateColumn Title="@Strings["Held"]" Context="row">@Display.Tonnes(row.Held)</TemplateColumn>
                </QuickGrid>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter] private PlayerScreenSnapshot? Screen { get; set; }

    [Parameter] public Guid SimulationId { get; set; }

    private PlayerView? View => Screen?.View;
}
