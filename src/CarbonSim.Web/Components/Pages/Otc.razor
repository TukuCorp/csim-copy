@page "/run/{SimulationId:guid}/otc"
@inject IStringLocalizer<SharedStrings> Strings
@inject PlayerContext Context

<PageTitle>@Strings["OtcMarket"]</PageTitle>
<h1>@Strings["OtcMarket"]</h1>

@if (View is not { } view)
{
    <ScreenFallback Screen="Screen" />
}
else
{
    @if (!view.System.OtcAccess)
    {
        <p class="notice notice-status market-closed" role="status">@Strings["OtcNotOpen"]</p>
    }
    <div class="cards">
        <section class="card">
            <h2>@Strings["SendOfferToSell"]</h2>
            <label>
                @Strings["UnitName"]
                <select id="offer-seller" @bind="_sellerUnitId">
                    @foreach (UnitView unit in view.Units)
                    {
                        <option value="@unit.Id">@unit.Name</option>
                    }
                </select>
            </label>
            <label>
                @Strings["UnitToTradeWith"]
                <input id="counterparty-filter" type="text" placeholder="@Strings["FilterUnits"]" @bind="_counterpartyFilter" @bind:event="oninput" />
                <select id="counterparty-unit" @bind="_buyerUnitId">
                    @foreach ((string Group, IReadOnlyList<CounterpartyView> Units) group in CounterpartyGroups)
                    {
                        <optgroup label="@group.Group">
                            @foreach (CounterpartyView counterparty in group.Units)
                            {
                                <option value="@counterparty.UnitId">@counterparty.Label</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
            <label>
                @Strings["Product"]
                <select id="offer-product" @bind="_productKey">
                    @foreach (ProductView product in view.TradableProducts)
                    {
                        <option value="@product.Key">@Display.Product(product, Strings) (@Strings["OnHand_X", Display.Tonnes(OnHand(view, product))])</option>
                    }
                </select>
            </label>
            <label>
                @Strings["Volume"]
                <input id="offer-volume" type="text" inputmode="decimal" @bind="_volume" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <label>
                @Strings["Price"] (@Display.Currency.Code)
                <input id="offer-price" type="text" inputmode="decimal" @bind="_price" @bind:culture="CultureInfo.CurrentCulture" />
            </label>
            <p id="offer-capital-cost" class="small muted">@Strings["CapitalCost"]: @Display.Money(Display.PriceFromInput(_price ?? 0m) * _volume)</p>
            <button id="send-offer" class="button" disabled="@(view.Counterparties.Count == 0)" @onclick="SendAsync">@Strings["SendOffer"]</button>
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["OffersToAnswer"]</h2>
            @if (view.OffersToAnswer.Count == 0)
            {
                <p class="muted">@Strings["NoRows"]</p>
            }
            else
            {
                <QuickGrid Items="@view.OffersToAnswer.AsQueryable()" Class="grid">
                    <TemplateColumn Title="@Strings["Seller"]" Context="row">@row.SellerCompany - @row.SellerUnit</TemplateColumn>
                    <TemplateColumn Title="@Strings["Product"]" Context="row">@row.Product.Key</TemplateColumn>
                    <TemplateColumn Title="@Strings["Volume"]" Context="row">@Display.Tonnes(row.Volume)</TemplateColumn>
                    <TemplateColumn Title="@Strings["Price"]" Context="row">@Display.Price(row.Price)</TemplateColumn>
                    <TemplateColumn Title="@Strings["CapitalCost"]" Context="row">@Display.Money(row.Consideration)</TemplateColumn>
                    <TemplateColumn Title="@Strings["Accept"]" Context="row">
                        <button class="button small-button" @onclick="() => AnswerAsync(row, true)">@Strings["Accept"]</button>
                        <button class="button small-button ghost" @onclick="() => AnswerAsync(row, false)">@Strings["Reject"]</button>
                    </TemplateColumn>
                </QuickGrid>
            }
        </section>
    </div>

    <section class="card wide" tabindex="0">
        <h2>@Strings["MyOffers"]</h2>
        @if (view.MyOffers.Count == 0)
        {
            <p class="muted">@Strings["NoRows"]</p>
        }
        else
        {
            <div id="my-offers">
                <QuickGrid Items="@view.MyOffers.AsQueryable()" Class="grid">
                    <TemplateColumn Title="@Strings["Buyer"]" Context="row">@row.BuyerCompany - @row.BuyerUnit</TemplateColumn>
                    <TemplateColumn Title="@Strings["Product"]" Context="row">@row.Product.Key</TemplateColumn>
                    <TemplateColumn Title="@Strings["Volume"]" Context="row">@Display.Tonnes(row.Volume)</TemplateColumn>
                    <TemplateColumn Title="@Strings["Price"]" Context="row">@Display.Price(row.Price)</TemplateColumn>
                    <TemplateColumn Title="@Strings["State"]" Context="row">@row.State</TemplateColumn>
                    <TemplateColumn Title="" Context="row">
                        @if (row.State == "Pending")
                        {
                            <button class="button small-button ghost" @onclick="() => CancelAsync(row)">@Strings["CancelOffer"]</button>
                        }
                    </TemplateColumn>
                </QuickGrid>
            </div>
        }
    </section>
}

@code {
    [CascadingParameter] private PlayerScreenSnapshot? Screen { get; set; }

    [Parameter] public Guid SimulationId { get; set; }

    /// <summary>What the company has free to offer of a product: held, less what is already set aside.</summary>
    private static decimal OnHand(PlayerView view, ProductView product) =>
        view.Holdings.FirstOrDefault(holding => holding.Product.Key == product.Key)?.Available ?? 0m;

    private int _sellerUnitId;
    private int _buyerUnitId;
    private string? _productKey;
    private decimal _volume = 1_000m;
    private decimal? _price;
    private string _counterpartyFilter = string.Empty;

    private PlayerView? View => Screen?.View;

    /// <summary>
    /// The units an offer may be addressed to, named once each and narrowed by whatever the player
    /// has typed. Two hundred and forty units is too many for a flat list, so the companies a
    /// person plays come first as one group and the bots follow by sector.
    /// </summary>
    private IReadOnlyList<(string Group, IReadOnlyList<CounterpartyView> Units)> CounterpartyGroups =>
        [.. (View?.Counterparties ?? [])
            .Where(counterparty => _counterpartyFilter.Length == 0
                || counterparty.Label.Contains(_counterpartyFilter.Trim(), StringComparison.CurrentCultureIgnoreCase))
            .GroupBy(counterparty => counterparty.Automated ? counterparty.SectorName : Strings["HumanCompanies"].Value)
            .Select(group => (
                Group: group.Key,
                Units: (IReadOnlyList<CounterpartyView>)[.. group]))];

    protected override void OnParametersSet()
    {
        if (View is not { } view)
        {
            return;
        }

        if (_sellerUnitId == 0 && view.Units.Count > 0)
        {
            _sellerUnitId = view.Units[0].Id;
        }

        if (_buyerUnitId == 0 && view.Counterparties.Count > 0)
        {
            _buyerUnitId = view.Counterparties[0].UnitId;
        }

        _productKey ??= view.TradableProducts.FirstOrDefault()?.Key;
        // The price box holds what the player typed, in the currency on screen.
        _price ??= Display.PriceInput(100m);
    }

    private Task SendAsync()
    {
        string product = _productKey ?? "Vintage 1";
        return Context.ActAsync(
            session => session.SendOtcOfferAsync(SimulationId, _sellerUnitId, _buyerUnitId, product, Display.PriceFromInput(_price ?? 0m), _volume),
            Strings["SendOffer"]);
    }

    private Task AnswerAsync(OtcOfferView offer, bool accept)
    {
        int unitId = View?.Units.FirstOrDefault(unit => string.Equals(unit.Name, offer.BuyerUnit, StringComparison.Ordinal))?.Id ?? 0;

        return Context.ActAsync(session => session.AnswerOtcOfferAsync(SimulationId, unitId, offer.Id, accept), Strings["SendOffer"]);
    }

    private Task CancelAsync(OtcOfferView offer) =>
        Context.ActAsync(session => session.CancelOtcOfferAsync(SimulationId, offer.Id), Strings["CancelOffer"]);
}
