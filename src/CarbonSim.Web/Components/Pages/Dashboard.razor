@page "/run/{SimulationId:guid}/dashboard"
@inject IStringLocalizer<SharedStrings> Strings

<PageTitle>@Strings["Dashboard"]</PageTitle>
<h1>@Strings["Dashboard"]</h1>

@if (View is not { } view)
{
    <ScreenFallback Screen="Screen" />
}
else
{
    <div class="cards">
        <section class="card">
            <h2>@Strings["MyFinance"]</h2>
            <dl class="metrics">
                <div><dt>@Strings["Capital"]</dt><dd>@Display.Money(view.Finance.Capital)</dd></div>
                <div><dt>@Strings["ForecastNetProfit"]</dt><dd>@Display.Signed(view.Finance.ForecastNetProfit)</dd></div>
                <div><dt>@Strings["InterestRate"]</dt><dd>@Display.Percent(view.System.OverdraftInterestRate)</dd></div>
                <div><dt>@Strings["Abatement"]</dt><dd>@view.Abatements.Count</dd></div>
                <div><dt>@Strings["NOPWithAbatement"]</dt><dd>@Display.Money(view.Finance.NopWithAbatement)</dd></div>
            </dl>
            <EChart Option="@Charts.NetProfit(view.Finance.NormalOperatingProfit, view.Finance.NopWithAbatement, Strings["NormalOperatingProfit"], Strings["NOPWithAbatement"])" Height="140px" Label="@Strings["NormalOperatingProfit"]" />
        </section>

        <section class="card">
            <h2>@Strings["MyCompliance"]</h2>
            <dl class="metrics">
                <div><dt>@Strings["ThisYear"]</dt><dd>@Display.Signed(view.Compliance.ThisYearCostOfCompliance)</dd></div>
                <div><dt>@Strings["ToDate"]</dt><dd>@Display.Signed(view.Compliance.OverallCostOfCompliance)</dd></div>
                <div><dt>@Strings["CurrentMarginalCostOfCompliance"]</dt><dd>@Display.Signed(view.Compliance.ThisYearMarginalCost)</dd></div>
                <div><dt>@Strings["OverallMarginalCostOfCompliance"]</dt><dd>@Display.Signed(view.Compliance.OverallMarginalCost)</dd></div>
            </dl>
            @if (view.Compliance.HasResult)
            {
                <p class="small">
                    @Strings["Covered"]: @Display.Tonnes(view.Compliance.Covered) /
                    @Display.Tonnes(view.Compliance.Obligation)
                    &middot; @Strings["Shortfall"]: @Display.Tonnes(view.Compliance.Shortfall)
                </p>
            }
        </section>

        <section class="card">
            <h2>@Strings["MyLongShortPosition"]</h2>
            <EChart Option="@Charts.LongShort(view.Position, view.CompanyName, Strings["AllowancesHeld"], Strings["Short"])" Height="140px" Label="@Strings["MyLongShortPosition"]" />
            <dl class="metrics">
                <div><dt>@Strings["FreeAllowancesThisYear"]</dt><dd>@Display.Tonnes(view.Position.FreeAllocation)</dd></div>
                <div><dt>@Strings["AllowancesHeld"]</dt><dd>@Display.Tonnes(view.Position.Held)</dd></div>
                <div><dt>@Strings["ForecastEmissions"]</dt><dd>@Display.Tonnes(view.Position.ForecastEmissions)</dd></div>
                <div><dt>@Strings["CurrentPosition"]</dt><dd>@Display.Position(view.Position, Strings)</dd></div>
            </dl>
        </section>

        <section class="card">
            <h2>@Strings["MyAbatementImplementationStatus"]</h2>
            @if (view.Abatements.Count == 0)
            {
                <p class="muted">@Strings["NoRows"]</p>
            }
            else
            {
                <ul class="timeline">
                    @foreach (AbatementView project in view.Abatements)
                    {
                        <li>
                            <span class="pill pill-@project.Status.ToLowerInvariant()">@Strings[project.Status]</span>
                            @project.Code @project.Name &middot; @project.UnitName
                            <span class="muted small">@Strings["Year_X", project.OperatingFromYear] - @project.ExpiresAfterYear &middot; @Display.Tonnes(project.AnnualReduction) t</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["MyAuctionHistory"]</h2>
            @if (MyBids(view) is not { Count: > 0 } bids)
            {
                <p class="muted">@Strings["NoRows"]</p>
            }
            else
            {
                <table class="grid" id="my-auction-history">
                    <thead>
                        <tr>
                            <th>@Strings["Year"]</th>
                            <th>@Strings["AuctionNumber"]</th>
                            <th>@Strings["Vintage"]</th>
                            <th>@Strings["YouBid"]</th>
                            <th>@Strings["BidVolume"]</th>
                            <th>@Strings["ClearedAt"]</th>
                            <th>@Strings["YouWon"]</th>
                            <th>@Strings["YouPaid"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach ((AuctionView auction, MyBidView bid) in bids)
                        {
                            <tr>
                                <td>@auction.Year</td>
                                <td>@auction.Sequence</td>
                                <td>@bid.Vintage</td>
                                <td>@Display.Price(bid.Price)</td>
                                <td>@Display.Tonnes(bid.Volume)</td>
                                <td>@(auction.IsCleared ? Display.Price(ClearedAt(auction, bid.Vintage)) : Strings["InProgress"])</td>
                                <td>@Display.Tonnes(bid.Awarded)</td>
                                <td>@Display.Money(bid.Cost)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="card wide" tabindex="0">
            <h2>@Strings["MyTradeHistory"]</h2>
            @if (view.MyTrades.Count == 0)
            {
                <p class="muted">@Strings["NoRows"]</p>
            }
            else
            {
                <table class="grid" id="my-trade-history">
                    <thead>
                        <tr>
                            <th>@Strings["Year"]</th>
                            <th>@Strings["Channel"]</th>
                            <th>@Strings["Product"]</th>
                            <th>@Strings["BuySell"]</th>
                            <th>@Strings["Price"]</th>
                            <th>@Strings["Volume"]</th>
                            <th>@Strings["Cost"]</th>
                            <th>@Strings["Counterparty"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TradeRow trade in view.MyTrades)
                        {
                            bool bought = string.Equals(trade.Buyer, view.CompanyName, StringComparison.Ordinal);
                            <tr>
                                <td>@trade.Year</td>
                                <td>@trade.Channel</td>
                                <td>@trade.Product</td>
                                <td>@(bought ? Strings["Buy"] : Strings["Sell"])</td>
                                <td>@Display.Price(trade.Price)</td>
                                <td>@Display.Tonnes(trade.Volume)</td>
                                <td>@Display.Money(trade.Price * trade.Volume)</td>
                                <td>@((bought ? trade.Seller : trade.Buyer) is { Length: > 0 } name ? name : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter] private PlayerScreenSnapshot? Screen { get; set; }

    [Parameter] public Guid SimulationId { get; set; }

    private PlayerView? View => Screen?.View;

    /// <summary>Every bid the company placed, oldest auction first, each with the auction it was in.</summary>
    private static List<(AuctionView Auction, MyBidView Bid)> MyBids(PlayerView view) =>
        [.. view.Auctions.SelectMany(auction => auction.MyBids.Select(bid => (auction, bid)))];

    /// <summary>Each vintage clears on its own; the company's award carries its lot's price.</summary>
    private static decimal? ClearedAt(AuctionView auction, int vintage) =>
        auction.MyAwards.FirstOrDefault(award => award.Vintage == vintage)?.Price ?? auction.ClearingPrice;
}
