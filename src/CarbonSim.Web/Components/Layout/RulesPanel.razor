@inject IStringLocalizer<SharedStrings> Strings

<div class="rules">
    <ul class="small">
        <li>@Strings["Cap"]: @Display.Money(View.System.Cap)</li>
        <li>@Strings["AnnualCapReductionRate"]: @Display.Percent2(View.System.AnnualCapReductionRate)</li>
        <li>@Strings["FreeAllocationShare"]: @Display.Percent(View.System.FreeAllocationShare)</li>
        <li>@Strings["OffsetUsageLimit"]: @Display.Percent(View.System.OffsetUsageLimit)</li>
        <li>@Strings["BankingLimit"]: @Display.Percent(View.System.BankingLimit)</li>
        <li>@Strings["PenaltyPerTonne"]: @Display.Money(View.System.PenaltyPerTonne)</li>
        <li>@Strings["AuctionFloorPrice"] / @Strings["AuctionCeilingPrice"]: @Display.Money(View.System.AuctionFloorPrice) / @Display.Money(View.System.AuctionCeilingPrice)</li>
        <li>@Strings["VolatilityBand"]: @Display.Percent(View.System.VolatilityBand)</li>
    </ul>
    <p class="muted small">@Strings["OffsetPriceDiscount"]</p>
    <p class="small"><strong>@Strings["ComplianceCostCalculator"]</strong>: @Strings["CalculatorHint"]</p>
</div>

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = default!;
}
