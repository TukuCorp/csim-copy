@inject IStringLocalizer<SharedStrings> Strings

<nav class="nav" aria-label="@Strings["Dashboard"]">
    @foreach ((string Screen, string Key) item in Screens.Where(Open))
    {
        <a href="@RunRoute.Screen(Id, item.Screen)">@Strings[item.Key]</a>
    }
</nav>

@code {
    [CascadingParameter] private PlayerScreenSnapshot? Screen { get; set; }

    private static readonly (string Screen, string Key)[] Screens =
    [
        ("dashboard", "Dashboard"),
        ("company", "CompanyManagement"),
        ("units", "UnitInformation"),
        ("abatement", "Abatement"),
        ("auction", "AllowanceAuction"),
        ("exchange", "ExchangeMarket"),
        ("otc", "OtcMarket"),
        ("surrender", "SurrenderAndBanking"),
        ("system", "SystemInfo"),
        ("leaderboard", "Leaderboard"),
        ("messages", "MessageLog"),
    ];

    private Guid Id => Screen?.SimulationId ?? Guid.Empty;

    /// <summary>A market the trainer has not opened in this exercise is left out of the menu.</summary>
    private bool Open((string Screen, string Key) item) => Screen?.View?.System is not { } system || item.Screen switch
    {
        "exchange" => system.ExchangeAccess,
        "otc" => system.OtcAccess,
        "leaderboard" => system.LeaderboardVisible,
        _ => true,
    };
}
