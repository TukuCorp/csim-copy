@inject ICharts Charts
@inject ILogger<EChart> Log

@* A canvas is opaque to a screen reader, so the chart is announced by its description and the
   same figures are always on the page beside it as text or a table. *@
<div class="chart" style="height: @(Height)" role="img" aria-label="@Label" @ref="_element"></div>

@code {
    /// <summary>The ECharts option, already serialised, so the component stays free of chart knowledge.</summary>
    [Parameter, EditorRequired] public string Option { get; set; } = "{}";

    [Parameter] public string Height { get; set; } = "220px";

    /// <summary>What the chart shows, in one sentence, for anyone who cannot see it.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    private ElementReference _element;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await Charts.RenderAsync(_element, Option);
        }
        catch (JSException exception)
        {
            // A chart that cannot be drawn must not take the player's screen down with it.
            Log.LogError(exception, "A chart could not be drawn.");
        }
    }
}
